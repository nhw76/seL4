declare_platform(manul KernelPlatformManul PLAT_MANUL KernelArchRiscV)
if(KernelPlatformManul)
    declare_seL4_arch(riscv64)
    config_set(KernelPlatformFirstHartID FIRST_HART_ID 0)
    config_set(KernelOpenSBIPlatform OPENSBI_PLATFORM "generic")
    if(KernelMaxNumNodes GREATER 4)
        message(FATAL_ERROR "Manul supports at most four harts")
    endif()
    # Supply the current machine description rather than hardcoding guest RAM.
    if(NOT MANUL_DTS OR NOT EXISTS "${MANUL_DTS}")
        message(FATAL_ERROR "Set MANUL_DTS to the DTS generated by Manul QEMU")
    endif()
    list(APPEND KernelDTSList "${MANUL_DTS}" "${CMAKE_CURRENT_LIST_DIR}/overlay-manul.dts")
    declare_default_headers(
        TIMER_FREQUENCY 165000000
        MAX_IRQ 31
        INTERRUPT_CONTROLLER drivers/irq/riscv_plic0.h
    )
endif()
