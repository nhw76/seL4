#pragma once

#include <config.h>

#define TIMER_CLOCK_HZ ULL_CONST(@CONFIGURE_TIMER_FREQUENCY@)

#include <machine/interrupt.h>

/* External source IDs form the public IRQ namespace. Local timer/IPI
 * pseudo-IRQs follow it and must never be interpreted as IMSIC identities.
 * Keep the PLIC names as compatibility aliases for existing drivers.
 */
enum IRQConstants {
    EXTERNAL_IRQ_OFFSET = 0,
    EXTERNAL_MAX_IRQ = EXTERNAL_IRQ_OFFSET + (@CONFIGURE_MAX_IRQ@),
    PLIC_IRQ_OFFSET = EXTERNAL_IRQ_OFFSET,
    PLIC_MAX_IRQ = EXTERNAL_MAX_IRQ,
#ifdef ENABLE_SMP_SUPPORT
    INTERRUPT_IPI_0,
    INTERRUPT_IPI_1,
#endif
    KERNEL_TIMER_IRQ,
    maxIRQ = KERNEL_TIMER_IRQ,
};

enum irqNumbers {
    irqInvalid = 0
};

#define IRQ_CNODE_SLOT_BITS (@CONFIGURE_IRQ_SLOT_BITS@)

#include <@CONFIGURE_INTERRUPT_CONTROLLER@>

#include <arch/machine/irq_backend.h>
